# --- Backend API (Express) ---
# API_PORT=4000

# Option A: connect via discrete Postgres fields (default for local dev)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres
# PGPASSWORD=root

# Option B: use a single connection string (Supabase or managed Postgres)
# PG_CONNECTION_STRING=postgresql://user:password@host:5432/db_name
# Alternatively, reuse Supabase's generated URL
# SUPABASE_DB_URL=postgresql://user:password@db.supabase.co:5432/postgres

# Enable TLS when connecting to managed providers (Supabase requires this)
# PGSSLMODE=require
# Set to "false" if your provider uses self-signed certs and you need to skip validation
# PGSSL_REJECT_UNAUTHORIZED=false

# Optionally seed the first admin account
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=admin123

# --- Frontend build / Capacitor bundle ---
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=public-anon-key

# Provide service-role key only to the backend API (never bundle it with the client)
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
VITE_API_BASE_URL=http://10.0.2.2:4001
VITE_SUPABASE_URL=http://10.0.2.2:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123